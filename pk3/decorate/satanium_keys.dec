actor SataniumRedCode : BaseMM8BDMUseItem
{
    inventory.pickupmessage "$KEY_REDCODE"
    inventory.pickupsound "item/key"
    translation "192:192=[255,155,155]:[255,155,155]", "198:198=[224,0,88]:[224,0,88]", "4:4=[255,255,255]:[255,255,255]", "210:210=[252,224,168]:[252,224,168]"
    scale 2.0
    States
    {
        SpawnLoop:
            S_KY I 35
            S_KY J 2
            S_KY K 10 bright
            S_KY L 2
            loop
        Pickup:
            S_KY A 0 ACS_NamedExecuteWithResult("satanium_givekey", 0)
            stop
    }
}
actor ChexSataniumRedCode : SataniumRedCode { States { Pickup: S_KY A 0 ACS_NamedExecuteWithResult("satanium_givekey", 0, 1) stop } }

