actor SataniumRedJewel : BaseMM8BDMUseItem
{
    inventory.pickupmessage "$KEY_REDJEWEL"
    inventory.pickupsound "item/key"
    translation "192:192=[255,155,155]:[255,155,155]", "198:198=[224,0,88]:[224,0,88]", "4:4=[255,255,255]:[255,255,255]", "210:210=[252,224,168]:[252,224,168]"
    +BRIGHT
    scale 2.0
    States
    {
        SpawnLoop:
            S_KY MN 5
            S_KY M 0 A_SpawnItemEx("SataniumJewelParticle", random(-18, 18), random(-18, 18), random(-2, 34), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION)
            loop
        Pickup:
            S_KY A 0 ACS_NamedExecuteWithResult("satanium_givekey", 3)
            stop
    }
}

