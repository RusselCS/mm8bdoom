actor SataniumJewelParticle : BasicGraphicEffect
{
    +FORCEXYBILLBOARD
    +BRIGHT
    Scale 2.0
    States
    {
    Spawn:
        S_KY STUVWTS 3
        stop
    }
}

// Exit Unit -- In case you get yourself stuck.
actor Satanium_ExitUnit : BaseMM8BDMUseItem
{
    inventory.amount 1
    inventory.maxamount 1
    inventory.pickupmessage "$PU_EXITUNIT"
    inventory.icon "EXITSI"
    Inventory.PickupSound "item/1up"
    Tag "$TAG_EXITUNIT"
    scale 2.0
    +COUNTITEM
    +INVBAR
    States
    {
    SpawnLoop:
        EXIT BC 6
        Loop
    Use:
        EXIT C 0 A_GiveInventory("Satanium_ExitUnitUse", 1)
        fail
    Death:
        EXIT A 1
        stop
    }
}

actor Satanium_ExitUnitUse : ArtiTeleport { +INVENTORY.AUTOACTIVATE }
