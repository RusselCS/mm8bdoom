const int SATANIUM_REVIVE_SPIN = 4;

actor Satanium_Pentagram_Floor : BasicGraphicEffect
{
    Scale 2.0
    +FORCEXYBILLBOARD
    +BRIGHT
    States
    {
        Spawn:
            TNT1 A 1
            wait
        ACSState0: // Archvile starts walking.
            STPN ABCB 5
            loop
        ACSState1: // Archvile dies or gets bored.
            STPN BA 5
            TNT1 A 1
            wait
        ACSState2: // Revive successful, even sans archvile.
            STPN A 0 A_SpawnItemEx("Satanium_Pentagram_Raise", 0, 0, 4, 0, 0, 0, 0, SXF_TRANSFERSCALE)
            STPN ABCDE 2 A_SetAngle(angle + SATANIUM_REVIVE_SPIN)
            STPN F 0 A_SpawnItemEx("Satanium_Pentagram_Raise", 0, 0, 0, 0, 0, 10, 0, SXF_TRANSFERSCALE)
            STPN FFGG 2 A_SetAngle(angle + SATANIUM_REVIVE_SPIN)
            STPN F 0 A_SpawnItemEx("Satanium_Pentagram_Raise", 0, 0, 0, 0, 0, 10, 0, SXF_TRANSFERSCALE)
            STPN FFGG 2 A_SetAngle(angle + SATANIUM_REVIVE_SPIN)
            STPN F 0 A_SpawnItemEx("Satanium_Pentagram_Raise", 0, 0, 0, 0, 0, 10, 0, SXF_TRANSFERSCALE)
            STPN FFGG 2 A_SetAngle(angle + SATANIUM_REVIVE_SPIN)
            STPN F 0 A_SpawnItemEx("Satanium_Pentagram_Raise", 0, 0, 0, 0, 0, 10, 0, SXF_TRANSFERSCALE)
            STPN BBAA 2 A_SetAngle(angle + SATANIUM_REVIVE_SPIN)
            stop
    }
}

actor ArchvileFire_Gone : ArchvileFire replaces ArchvileFire { renderstyle "none" }

actor Satanium_Pentagram_Raise : Satanium_Pentagram_Floor
{
    renderstyle "add"
    alpha 0.8
    States
    {
        Spawn:
            TNT1 A 0 nodelay A_SetScale(scalex, scalex) // need scalex on both because flatsprite script tweaks scaley
            TNT1 A 0 A_ClientsideACSExecute("satanium_flatsprite", -4)
            TNT1 A 0 A_JumpIf(momz == 0, "Animate")
            goto Float
        Animate:
            TNT1 A 0 A_SetScale(scalex*1.1, scaley*1.1)
            STPN A 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN B 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN C 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN D 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN E 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN F 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN F 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN G 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN G 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN F 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN F 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN G 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN G 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN F 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN F 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN G 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN G 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN B 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN B 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN A 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            STPN A 0 A_SetAngle(angle - SATANIUM_REVIVE_SPIN)
            STPN A 2 A_SetTranslucent(alpha < 1.0 ? 1.0 : 0.8, 1)
            stop
        Float:
            STPN C 5
            STPN BA 2
            stop
    }
}

