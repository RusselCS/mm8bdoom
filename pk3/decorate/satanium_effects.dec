actor Satanium_TPFog : TeleportFog replaces TeleportFog {}
actor Satanium_ItemFog : ItemFog replaces ItemFog {}

actor Satanium_Blood_Small : BasicGraphicEffect
{
    Translation "192:192=[165,0,0]:[165,0,0]", "198:198=[231,0,90]:[231,0,90]"
    +FORCEXYBILLBOARD
    scale 2.0
    States
    {
        Spawn:
            TNT1 A 0
            TNT1 A 0 A_PlaySoundEx("effects/blood", "body")
            TNT1 A 0 A_Jump(256, "Blood1", "Blood2", "Blood3", "Blood4")
            TNT1 A 1
            wait
        Blood1:
            S_BL ABCD 2
            stop
        Blood2:
            S_BL EFGH 2
            stop
        Blood3:
            S_BL IJKL 2
            stop
        Blood4:
            S_BL MNOP 2
            stop
    }
}
actor Satanium_Blood_Small_Green : Satanium_Blood_Small { translation "192:192=[0,168,68]:[0,168,68]", "198:198=[128,208,16]:[128,208,16]" }

actor Satanium_Blood_Big : Satanium_Blood_Small
{
    States
    {
        Spawn:
            TNT1 A 0
            TNT1 A 0 A_PlaySoundEx("effects/gib", "body")
            S_BL QRS 2
            stop
    }
}
actor Satanium_Blood_Big_Green : Satanium_Blood_Big { translation "192:192=[0,168,68]:[0,168,68]", "198:198=[128,208,16]:[128,208,16]" }

actor Satanium_Blood_Reverse : Satanium_Blood_Big
{
    States
    {
        Spawn:
            TNT1 A 0
            TNT1 A 0 A_PlaySoundEx("effects/gib/reverse", "body")
            S_BL SRQ 2
            stop
    }
}
actor Satanium_Blood_Reverse_Green : Satanium_Blood_Reverse { translation "192:192=[0,168,68]:[0,168,68]", "198:198=[128,208,16]:[128,208,16]" }

actor Satanium_JustBled : Powerup { powerup.duration 4 }
actor Satanium_HitFlash : Powerup { powerup.duration 7 }

// Drives conditional monster effects

// Archvile -- Some VFX trigger when an archvile is active and wandering around.
// Also when a monster is revived.
actor Satanium_IsArchvile : Once {}
actor Satanium_NotArchvile : Once {}

// Archvile check is simple.
actor Satanium_CheckArchvile : CustomInventory
{
    States
    {
        Pickup:
            TNT1 A 0 A_JumpIf(CheckClass("Archvile", 0, true), "IsArchvile")
            TNT1 A 0 A_GiveInventory("Satanium_NotArchvile", 1)
            stop
        IsArchvile:
            TNT1 A 0 A_GiveInventory("Satanium_IsArchvile", 1)
            stop
    }
}

// Gotta mark corpses somehow...
actor Satanium_Blood_Floor : BasicGraphicEffect
{
    scale 2.0
    +FORCEXYBILLBOARD
    // Translation "192:192=[165,0,0]:[165,0,0]", "198:198=[231,0,90]:[231,0,90]"
    States
    {
        Spawn:
            S_BL Q 0 nodelay A_ClientsideACSExecute("satanium_flatsprite")
            S_BL QR 2
            wait
        ACSState2: // Archvile revive successful.
            S_BL Q 4
            S_BL Q 4 A_SetScale(scalex/2, scaley/2)
            stop
    }
}
actor Satanium_Blood_Floor_Green : Satanium_Blood_Floor { // translation "192:192=[0,168,68]:[0,168,68]", "198:198=[128,208,16]:[128,208,16]"
}

// Archvile revive effects.
actor Satanium_Archvile_State_Wander_CI : CustomInventory
{
    States
    {
    Pickup:
        TNT1 A 0 A_GiveToChildren("Satanium_Archvile_State_Wander_Child_CI", 1)
        stop
    }
}

actor Satanium_Archvile_State_Wander_Child_CI : CustomInventory
{
    States
    {
    Pickup:
        TNT1 A 0 ACS_NamedExecuteWithResult("core_setactorstate", 0, 0)
        stop
    }
}

actor Satanium_Archvile_State_Gone_CI : CustomInventory
