actor Satanium_Undropped : CUstomInventory
{
    states
    {
        Pickup:
            TNT1 A 0 A_ChangeFlag(DROPPED, false)
            stop
    }
}

actor Satanium_Blood_Small : BasicGraphicEffect
{
    +FORCEXYBILLBOARD
    scale 2.0
    States
    {
        Spawn:
            TNT1 A 0
            TNT1 A 0 A_PlaySoundEx("effects/blood", "body")
            TNT1 A 0 A_Jump(256, "Blood1", "Blood2", "Blood3", "Blood4")
            TNT1 A 1
            wait
        Blood1:
            S_BL ABCD 2
            stop
        Blood2:
            S_BL EFGH 2
            stop
        Blood3:
            S_BL IJKL 2
            stop
        Blood4:
            S_BL MNOP 2
            stop
    }
}

actor Satanium_Blood_Big : Satanium_Blood_Small
{
    States
    {
        Spawn:
            TNT1 A 0
            TNT1 A 0 A_PlaySoundEx("effects/gib", "body")
            S_BL QRS 2
            stop
    }
}

actor Satanium_Blood_Big : Satanium_Blood_Small
{
    States
    {
        Spawn:
            TNT1 A 0
            TNT1 A 0 A_PlaySoundEx("effects/gib", "body")
            S_BL QRS 2
            stop
    }
}

actor Satanium_Blood_Big_Reverse : Satanium_Blood_Big
{
    States
    {
        Spawn:
            TNT1 A 0
            TNT1 A 0 A_PlaySoundEx("effects/gib/reverse", "body")
            S_BL SRQ 2
            stop
    }
}

actor Satanium_JustBled : Powerup { powerup.duration 4 }

actor Satanium_ExitUnit : BaseMM8BDMUseItem
{
    inventory.amount 1
    inventory.maxamount 1
    inventory.pickupmessage "$PU_EXITUNIT"
    inventory.icon "EXITSI"
    Inventory.PickupSound "item/1up"
    Tag "$TAG_EXITUNIT"
    scale 2.0
    +COUNTITEM
    +INVBAR
    States
    {
    SpawnLoop:
        EXIT BC 6
        Loop
    Use:
        EXIT C 0 A_GiveInventory("Satanium_ExitUnitUse", 1)
        fail
    Death:
        EXIT A 1
        stop
    }
}

actor Satanium_ExitUnitUse : ArtiTeleport { +INVENTORY.AUTOACTIVATE }
