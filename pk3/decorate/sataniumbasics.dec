actor SataniumWepReplacer : Inventory
{
    -SOLID
    +NOINTERACTION
    +NOCLIP
    height 2
    radius 2
    renderstyle "none"
    mass 999
    accuracy 999
    meleerange 999
    states
    {
    Spawn:
        TNT1 A 0 nodelay ACS_NamedExecuteWithResult("satanium_replacepickup", mass, accuracy, meleerange)
        TNT1 A 4
        stop
    }
}

actor Satanium_TPFog : TeleportFog replaces TeleportFog {}
actor Satanium_ItemFog : ItemFog replaces ItemFog {}

