actor SataniumWepReplacer : Inventory
{
    -SOLID
    +NOINTERACTION
    +NOCLIP
    height 2
    radius 2
    renderstyle "none"
    mass 999
    accuracy 999
    meleerange 999
    states
    {
    Spawn:
        TNT1 A 0 nodelay ACS_NamedExecuteWithResult("satanium_replacepickup", mass, accuracy, meleerange)
        TNT1 A 4
        stop
    }
}

actor SataniumGhostMissile : Actor
{
    +MISSILE
    +NOINTERACTION
    States
    {
    Spawn:
        TNT1 A 0
        stop
        PLY1 BCDE 4
        loop
    }
}

actor SataniumSwitchHitter : BulletPuff
{
    -ALLOWPARTICLES
    +MTHRUSPECIES
    +BLOODLESSIMPACT
    vspeed 0
    renderstyle none
    States
    {
    Spawn:
        TNT1 A 0
        stop
        GUTS BCDE 4
        loop
    }
}

actor Satanium_Undropped : CUstomInventory
{
    states
    {
        Pickup:
            TNT1 A 0 A_ChangeFlag(DROPPED, false)
            stop
    }
}
