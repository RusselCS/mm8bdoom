// Doom -------------------------------------------------------------------------------------------
actor Chainsawreplace : SataniumWepReplacer replaces Chainsaw { mass 1 }
actor Pistolreplace : SataniumWepReplacer replaces Pistol { mass 2 }
actor Shotgunreplace : SataniumWepReplacer replaces Shotgun { mass 2 }
actor Chaingunreplace : SataniumWepReplacer replaces Chaingun { mass 3 }
