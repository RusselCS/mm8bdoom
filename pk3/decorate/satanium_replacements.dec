actor BFG9000replace : SataniumWepReplacer replaces BFG9000 { mass 6 }
actor DoomBigArmorReplace : SataniumWepReplacer replaces BlueArmor { mass 7 }

// accuracy 5 -- DTADD_GRP_ATTACK
actor BerserkReplace : SataniumWepReplacer replaces Berserk { mass 1 }

