actor SataniumArmor_F : Once { inventory.maxamount 200 }
actor SataniumArmorBar1_F : Once { inventory.maxamount 100 }
actor SataniumArmorBar2_F : SataniumArmorBar1_F {}
actor SataniumArmorHealthBar_F : SataniumArmorBar1_F {}

actor SataniumSmallerArmor : BaseMM8BDMItem
{
//$Category MM8BDM-Energy
//$Title Small Health
//$Sprite HBALA0
//Inventory.RespawnTics 210
//$Color 14
var int user_RemoveAsArmor;
inventory.pickupmessage "$PU_SMALLERARMOR"
+COUNTITEM
inventory.pickupsound "item/energyup/tiny"
Scale 2.0
States
{
SpawnLoop:
STRM ABCD 5
loop
Pickup:
TNT1 A 0 ACS_NamedExecuteWithResult("satanium_handleshield_pickup", 1)
}
}

actor SataniumBigArmor_P : BasicArmorBonus
{
    armor.maxsaveamount 9999
    armor.savepercent 100
    armor.saveamount 55
}

actor SataniumBigArmor : BaseMM8BDMItem
{
var int user_RemoveAsArmor;
inventory.pickupmessage "$PU_BIGARMOR"
+COUNTITEM
inventory.pickupsound "item/energyup/large"
Scale 2.0
States
{
SpawnLoop:
STRM EFGH 5
loop
Pickup:
TNT1 A 0 ACS_NamedExecuteWithResult("satanium_handleshield_pickup", 55)
}
}
