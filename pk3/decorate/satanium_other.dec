actor SataniumArmor_F : Once { inventory.maxamount 200 }
actor SataniumArmorBar1_F : Once { inventory.maxamount 100 }
actor SataniumArmorBar2_F : SataniumArmorBar1_F {}
actor SataniumArmorHealthBar_F : SataniumArmorBar1_F {}

actor SataniumSmallerArmor : BaseMM8BDMItem
{
//$Category MM8BDM-Energy
//$Title Small Health
//$Sprite HBALA0
//Inventory.RespawnTics 210
//$Color 14
var int user_RemoveAsArmor;
inventory.pickupmessage "$PU_SMALLERARMOR"
+COUNTITEM
inventory.pickupsound "item/energyup/tiny"
Scale 2.0
States
{
SpawnLoop:
STRM ABCD 5
loop
Pickup:
TNT1 A 0 ACS_NamedExecuteWithResult("satanium_handleshield_pickup", 2)
}
}

actor SataniumBigArmor_P : BasicArmorBonus
{
    armor.maxsaveamount 9999
    armor.savepercent 100
    armor.saveamount 55
}

actor SataniumBigArmor : BaseMM8BDMItem
{
var int user_RemoveAsArmor;
inventory.pickupmessage "$PU_BIGARMOR"
+COUNTITEM
inventory.pickupsound "item/energyup"
Scale 2.0
States
{
SpawnLoop:
STRM EFGH 5
loop
Pickup:
TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("satanium_handleshield_pickup", 100), "Succeed")
fail
Succeed:
TNT1 A 0 A_PlaySoundEx("item/armorup", "voice")
stop
}
}

actor SataniumBiggerHealth : BaseMM8BDMItem
{
var int user_RemoveAsHealth;
inventory.pickupmessage "$PU_BIGGERHEALTH"
+COUNTITEM
inventory.pickupsound "item/energyup/large"
Scale 2.0
States
{
SpawnLoop:
STRM LMNO 5
loop
Pickup:
TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("satanium_handleshield_pickup_healfirst", 120), "Succeed")
fail
Succeed:
TNT1 A 0 A_PlaySoundEx("item/armorup", "voice")
stop
}
}

actor SataniumBiggestHealth : BaseMM8BDMItem
{
var int user_RemoveAsHealth;
inventory.pickupmessage "$PU_BIGGESTHEALTH"
+COUNTITEM
inventory.pickupsound "item/energyup/large"
Scale 2.0
Translation "192:192=4:4", "198:198=41:41"
States
{
SpawnLoop:
STRM P 0 Thing_ChangeTID(0,999)
STRM P 5
STRM Q 5 BRIGHT
STRM Q 0 A_SpawnItemEx("SataniumJewelParticle", random(-18, 18), random(-18, 18), random(-2, 34), 0, 0, 0, 0, SXF_TRANSFERTRANSLATION)
goto SpawnLoop+1
Pickup:
TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("satanium_handleheartpart"), "Succeed")
fail
Succeed:
TNT1 A 0 A_PlaySoundEx("item/bigitem", "voice")
stop
}
}
