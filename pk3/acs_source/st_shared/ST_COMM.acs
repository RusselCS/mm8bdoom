
#define FIELD_NAME 0
#define FIELD_PARENT 1
#define FIELD_STATES 2
#define FIELD_TRANSLATION 3
#define FIELD_OBITUARY 4
#define FIELD_GAME 5

#define FIELD_MAX 6

function bool canISeeItXYZH(int tid, int x, int y, int z, int h)
{
    int u = UniqueTID();
    int u2 = UniqueTID(u+1);
    int res;

    res = 0;
    res += SpawnForced("MapSpot", x, y, z, u, 0);
    res += SpawnForced("MapSpot", x, y, z+h, u, 0);
    if(res < 2) {
        Thing_Remove(u);
        return false;
    }

    res = 0;
    res += SpawnForced("MapSpot", GetActorx(tid), GetActory(tid), GetActorz(tid), u2, 0);
    res += SpawnForced("MapSpot", GetActorx(tid), GetActory(tid), GetActorz(tid)+GetActorProperty(tid, AProp_Height), u2, 0);
    if(res < 2) {
        Thing_Remove(u2);
        return false;
    }

    res = CheckSight(u, u2, 0);
    Thing_Remove(u);
    Thing_Remove(u2);
    return res;
}

function void transferPointer(int src, int dest, int srcptr, int destptr)
{
    ACS_NamedExecuteWithResult("satanium_transferpointers", src, dest, srcptr, destptr);
}

function bool checkClassFlag(str cls, str flag)
{
    int u = uniqueTID();
    if(!Spawn(cls, 0, 0, 0, u, 0))
        return false;
    int ret = CheckFlag(u, flag);
    Thing_Remove(u);
    return ret;
}

function bool MM8BDMPlayer(void)
{
    if(PlayerNumber() < 0) return false;
    if(CheckInventory("MM8BDMPlayer") == 0) return false;
    return true;
}
