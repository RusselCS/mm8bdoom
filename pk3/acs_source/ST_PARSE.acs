#library "ST_PARSE"

#include "zcommon.acs"

#include "ST_COMM.acs"
#include "ST_CONST.acs"

#define MAX_INT 2147483647

world int GLB_DECORATE: f[];
world str GLB_DECORATE: actors[];

#define DEF_INIT 0
#define DEF_COUNT 1

function str getActorField(int idx, int prop) { return actors[(1+idx)*FIELD_MAX+prop]; }
function void setActorField(int idx, int prop, int res) { actors[(1+idx)*FIELD_MAX+prop] = res; }
function int findActor(str act) {
    int low = 0;
    int high = getActorField(-1, DEF_COUNT)-1;
    int res;

    while(low <= high) {
        int mid = low + (high - low) / 2;
        res = StrICmp(getActorField(mid, FIELD_NAME), act);
        if(res == 0)
            return mid;

        if (res < 0)
            low = mid+1;
        else
            high = mid-1;
    }

    return -1;
}

// these for the most part coincide with the control logic
// the sole exceptions at the moment are `#include` and `actor`, which take the first two slots
#define KEY_INCLUDE FIELD_NAME
#define KEY_ACTOR FIELD_PARENT

int fieldKeys[FIELD_MAX][20] = {
    {8, '#','i','n','c','l','u','d','e'},
    {5, 'a','c','t','o','r'},
    {6, 's','t','a','t','e','s'},
    {11,'t','r','a','n','s','l','a','t','i','o','n'},
    {8, 'o','b','i','t','u','a','r','y'},
    {4, 'g','a','m','e'},
};

function bool checkKey(int st, int len, int key)
{
    if(fieldKeys[key][0] != len)
        return false;
    for(int i = 0; i < len; i++) {
        if(!charMatch(f[st+i], fieldKeys[key][i+1]))
            return false;
    }
    return true;
}

#define FLOW_LOOP 0
#define FLOW_STOP 1
#define FLOW_WAIT 2
#define FLOW_FAIL 3
#define FLOW_GOTO 4
int flowKeys[5][4] = {
    {'l','o','o','p'},
    {'s','t','o','p'},
    {'w','a','i','t'},
    {'f','a','i','l'},
    {'g','o','t','o'},
};

function int checkFlow(int st, int len)
{
    if(4 != len)
        return -1;
    for(int key = 0; key < 5; key++) {
        for(int i = 0; i < len; i++) {
            if(charMatch(f[st+i], flowKeys[key][i]))
                return key;
        }
    }
    return -1;
}

#define MAX_ARRAY_SIZE MAX_INT >> 10

str fileList[MAX_ARRAY_SIZE][2];
str tempActors[MAX_ARRAY_SIZE][FIELD_MAX];
int actorIdx[MAX_ARRAY_SIZE];

#define STATE_ACTOR 0
#define STATE_LABEL 1
#define STATE_SPRITE 2
#define STATE_FRAMES 3
#define STATE_TICS 4
#define STATE_KEYWORDS 5
#define STATE_FUNCTION 6
#define STATE_PARAMETERS 7
#define STATE_NEXT 8
#define STATE_PROP_MAX 9

world str GLB_STATES: states[];
function str getStateProp(int idx, int prop) { return states[idx*STATE_PROP_MAX+prop]; }
function void setStateProp(int idx, int prop, int res) { states[idx*STATE_PROP_MAX+prop] = res; }
int MAX_STATES = 0;

// Perform a binary search to find the best slot to put this in.
function int findTempPivot(str key, int actorCount)
{
    if(actorCount == 0)
        return 0;

    int low = 0;
    int high = actorCount-1;
    int res;
    // Log(s:"Size: ", i:actorCount);

    res = StrICmp(tempActors[actorIdx[high]][FIELD_NAME], key);
    if(res < 0) {
        return actorCount;
    }

    res = StrICmp(tempActors[actorIdx[low]][FIELD_NAME], key);
    if(res >= 0) {
        return 0;
    }

    while(high-low > 1) {
        int mid = low + (high - low) / 2;
        res = StrICmp(tempActors[actorIdx[mid]][FIELD_NAME], key);

        if (res < 0)
            low = mid;
        else
            high = mid;
    }

    return high;
}

function int findTempActor(str key, int size)
{
    int low = 0;
    int high = size-1;
    int res;

    while(low <= high) {
        int mid = low + (high - low) / 2;
        res = StrICmp(tempActors[actorIdx[mid]][FIELD_NAME], key);
        if(res == 0)
            return actorIdx[mid];

        if (res < 0)
            low = mid+1;
        else
            high = mid-1;
    }

    return -1;
}

function void testSort(int actorCount)
{
    int res = true;
    for(int i = 1; i < actorCount; i++)
    {
        if(StrICmp(tempActors[actorIdx[i-1]][FIELD_NAME], tempActors[actorIdx[i]][FIELD_NAME]) >= 0) {
            res = false;
            break;
        }
    }
    if(res) {
        Log(s:"\n+++ ARRAY IS SORTED! +++\n");
    } else {
        Log(s:"\n+++ ARRAY IS NOT SORTED! +++\n");
    }
}

function bool isWhiteSpace(int x)
{
    if(x == 32) return true; // space
    if(x == '\t') return true;
    if(x == '\n') return true;
    if(x == 10) return true; // line feed
    if(x == 13) return true; // carriage return
    return false;
}

function bool isInit(void)
{
    return getActorField(-1, DEF_INIT);
}

function int lo(int x)
{
    if(x < 'A') return x;
    if(x > 'Z') return x;
    return x + 32;
}

function bool charMatch(int x, int y)
{
    return lo(x) == lo(y);
}

function bool isNumber(int x)
{
    if(x < '0') return false;
    if(x > '9') return false;
    return true;
}

// Pointers for the tokenizer.
int start, end, length, eof;

// Symbols that can start a token.
function bool tokenStarter(int i)
{
    // if(i >= eof) return false;
    return !isWhiteSpace(f[i]);
}

// Symbols that can end a token.
function bool tokenEnder(int i)
{
    int res = tokenEnder_(i);
    if(res) {
        // // Log(s:"Char in slot ", i:i, s:" (", i:f[i], s:") is a token ender.");
    } else {
        // // Log(s:"Char in slot ", i:i, s:" (", i:f[i], s:") is NOT a token ender.");
    }
    return res;
}

function bool tokenEnder_(int i)
{
    if(isCommentStarter(i) > 0) return true;
    int x = f[i];
    if(x == ':') return true;
    if(x == '"') return true;
    if(x == '(') return true;
    if(x == ')') return true;
    if(x == '{') return true;
    if(x == '}') return true;
    return isWhiteSpace(x);
}

function int isCommentStarter(int i)
{
    int x = f[i];
    if(x != '/') return 0;
    if(i+1 >= eof) return 0;
    int y = f[i+1];
    if(y == '/') return 1;
    if(y == '*') return 2;
    return 0;
}

function bool isCommentEnder(int i, int style)
{
    int x = f[i];
    if(style == 1) { // line
        if(x == '\n') return true;
    } else { // block
        if(x != '*') return false;
        if(i+1 >= eof) return false;
        int y = f[i+1];
        if(y == '/') return true;
    }
    return false;
}

// Symbols that are themselves tokens because they handle flow control.
function bool symbolToken(int i)
{
    int x = f[i];
    if(x == ':') return true;
    if(x == ',') return true;
    if(x == '{') return true;
    if(x == '}') return true;
    return false;
}

function int tokenizeFile(str file, int st, int flags) {
    int res = LumpOpen(file, st, flags);
    // // Log(s:file, s:" found at index ", i:res);
    if(res == -1)
        return -1;
    start = 0;
    end = -1;
    eof = LumpGetInfo(res, LUMP_INFO_SIZE);
    LumpReadArray(res, 0, f, 0);

    return res;
}

function bool nextToken(void)
{
    int i = end+1;

    if(i >= eof) {
        start = eof;
        end = eof;
        return false;
    }

    // // Log(s:"Finding token start.");
    while(!tokenStarter(i)) {
        if(i >= eof) {
            start = eof;
            end = eof;
            return false;
        }
        i++;
    }
    start = i;
    // // Log(s:"fhfh ", c:f[i]);
    // // Log(s:"Token starter is #", i:f[i], s:" whitespace: ", i:isWhiteSpace(f[i]));
    if(symbolToken(i)) {
        end = start;
        length = 1;
        return true;
    }

    i++;

    int commentStyle = isCommentStarter(start);

    if(f[start] == '(') {
        // // // Log(s:"Finding token end.");
        while(f[i] != ')') {
            if(i >= eof) break;
            i++;
        }
        i++;
    } else if(f[start] == '"') {
        // // // Log(s:"Finding token end.");
        while(f[i] != '"') {
            if(f[i] == 92) i++; // escape character
            if(i >= eof) break;
            i++;
        }
        i++;
    } else if(commentStyle > 0) {
        while(!isCommentEnder(i, commentStyle)) {
            if(i >= eof) break;
            i++;
        }
        if(commentStyle == 2) {
            i+=2;
        }
    } else {
        while(!tokenEnder(i)) {
            if(i >= eof) break;
            i++;
        }
    }
    end = i-1;

    length = end-start+1;
    return hasNext();
}

function bool next(void)
{
    int res;
    while(true) {
        res = nextToken();
        if(!res) break;
        if(!isComment(start)) break;
    }

    // Log(s:"Current token: ", a:(f, start, length));

    return res;
}

function bool hasNext(void)
{
    return end < eof;
}

function bool isComment(int st)
{
    if(f[st] != '/') return false;
    if(f[st+1] == '/') return true;
    if(f[st+1] == '*') return true;
    return false;
}

script "bigdata_client" OPEN CLIENTSIDE BUSY
{
    CallACS("bigdata");
}

script "bigdata" OPEN BUSY
{
    if(isInit()) terminate;
    if(GameType() == GAME_TITLE_MAP) terminate;

    int len = 0;
    int fileCount = 0;
    int currFile = 0;

    int actorCount = 0;
    int i;

    // // Log(s:"Putting the first decorate in...");
    fileList[fileCount][0] = "DECORATE";
    fileList[fileCount][1] = 0;

    // fileList[fileCount][0] = "decorate/_satanium_root.dec";
    // fileList[fileCount][1] = LUMP_OPEN_FULLPATH;

    fileCount++;
    // // Log(s:"Succeeded");

    int protoIdx = -1;
    int currIdx = -1;
    str currActor;

    while(currFile < fileCount) {
        int index = 0;
        while(true) {
            index = tokenizeFile(fileList[currFile][0], index, fileList[currFile][1]);
            if(index == -1) {
                // Log(s:"exiting.");
                break;
            }

            bool lineComment = false;
            bool blockComment = false;
            bool inString = false;
            bool inActor = false;
            int j, m, n, goal;
            int fieldStart, fieldEnd;

            while(next())
            {
                // // Log(s:"Current token: '", a:(f, start, length), s:"' length: ", i:length);

                if(checkKey(start, length, KEY_INCLUDE)) {
                    if(!next()) break;
                    if(f[start] == '"') {
                        fileList[fileCount][0] = StrParam(a:(f, start+1, length-2));
                        fileList[fileCount][1] = LUMP_OPEN_FULLPATH;
                        // Log(s:"Adding file ", s:fileList[fileCount][0]);
                        fileCount++;
                    }
                }

                if(checkKey(start, length, KEY_ACTOR)) {
                    if(!next()) break;
                    if(f[start] == '"')
                        currActor = StrParam(a:(f, start+1, length-2));
                    else
                        currActor = StrParam(a:(f, start, length));

                    currIdx = findTempActor(currActor, actorCount);
                    if(currIdx == -1) {
                        currIdx = actorCount;
                    } else {
                        // grumble grumble
                        for(j = 0; j < FIELD_MAX; j++) {
                            tempActors[currIdx][j] = 0;
                        }
                    }
                    tempActors[currIdx][FIELD_NAME] = currActor;

                    if(protoIdx == -1)
                        if(StrCmp("Actor", tempActors[currIdx][FIELD_NAME]) == 0)
                            protoIdx = currIdx;

                    // Iterate until the first opening brace.
                    while(next()) {
                        if(f[start] == '{')
                            break;
                        // Log(s:"FLOW CONTROL: ACTOR HEADER");

                        if(f[start] == ':') {
                            if(!next()) break;

                            if(f[start] == '"')
                                tempActors[currIdx][FIELD_PARENT] = StrParam(a:(f, start+1, length-2));
                            else
                                tempActors[currIdx][FIELD_PARENT] = StrParam(a:(f, start, length));
                        }

                        // if(checkKey(start, length, KEY_REPLACES)) {

                        // }
                    }

                    // Iterate until the closing brace.
                    while(next()) {
                        if(f[start] == '}')
                            break;

                        if(checkKey(start, length, FIELD_STATES)) {
                            // Log(s:"FLOW CONTROL: SEARCHING STATES");
                            while(f[start] != '{') { next(); } // no safety rails cuz the engine does it for me 🥳
                            // Log(s:"======= In state machine for actor ", s:tempActors[currIdx][FIELD_NAME]);

                            /*
                            str tempStates[MAX_ARRAY_SIZE][9];
                            #define STATE_ACTOR 0
                            #define STATE_LABEL 1
                            #define STATE_SPRITE 2
                            #define STATE_FRAMES 3
                            #define STATE_TICS 4
                            #define STATE_KEYWORDS 5
                            #define STATE_FUNCTION 6
                            #define STATE_PARAMETERS 7
                            #define STATE_NEXT 8
                            */

                            int pStart, pLength, pEnd, lookup, resolved;
                            str stActor = tempActors[currIdx][FIELD_NAME];
                            str stLabel = -1;
                            str stSprite = -1;
                            str stFrames = -1;
                            str stTics = -1;
                            str stKeywords = -1;
                            int stFunction = -1;
                            str stParameters = -1;
                            int stNext = 0;
                            int stStart = MAX_STATES;
                            tempActors[currIdx][FIELD_STATES] = MAX_STATES;

                            next(); // discard {
                            while(true) { // scan the state machine!!

                                pStart = start;
                                pEnd = end;
                                pLength = length;

                                if(!next()) break;
                                // // Log(s:"-- Current Token: ", a:(f, start, length));
                                resolved = false;

                                lookup = checkFlow(pStart, pLength);
                                if(lookup != -1) {
                                    switch(lookup) {
                                        case FLOW_LOOP: stNext = stStart; break;
                                        case FLOW_STOP: stNext = -1; break;
                                        case FLOW_WAIT: stNext = MAX_STATES; break;
                                        case FLOW_FAIL: stNext = -1; break;
                                        case FLOW_GOTO: stNext = -1; break; // TODO: ACTUALLY POPULATE THIS.
                                    }
                                    resolved = true;
                                }

                                if(f[start] == ':') {
                                    stLabel = strParam(a:(f, pStart, pLength));
                                    stStart = MAX_STATES;
                                    // Log(s:"New state: ", s:stLabel);
                                    continue;
                                }

                                // [Russ] I have a slot defined for these, but i'll skip this for now.
                                lookup = findKeyword(pStart, pLength);
                                if(lookup != -1) {
                                    // Log(s:"KEYWORD FOUND!! ", a:(f, pStart, pLength));
                                    continue;
                                }

                                // HERE'S the meat and potatoes.
                                lookup = findFunction(pStart, pLength);
                                if(lookup != -1) {
                                    // Log(s:"FUNCTION FOUND!! ", a:(f, pStart, pLength));
                                    stFunction = lookup;
                                    if(f[start] == '(')
                                        stParameters = strParam(a:(f, start+1, length-2));
                                    resolved = true;
                                }

                                if(f[start] == '}' || resolved) {
                                    setStateProp(MAX_STATES, STATE_ACTOR, stActor);
                                    setStateProp(MAX_STATES, STATE_LABEL, stLabel);
                                    setStateProp(MAX_STATES, STATE_SPRITE, stSprite);
                                    setStateProp(MAX_STATES, STATE_FRAMES, stFrames);
                                    setStateProp(MAX_STATES, STATE_TICS, stTics);
                                    setStateProp(MAX_STATES, STATE_KEYWORDS, stKeywords);
                                    setStateProp(MAX_STATES, STATE_FUNCTION, stFunction);
                                    setStateProp(MAX_STATES, STATE_PARAMETERS, stParameters);
                                    setStateProp(MAX_STATES, STATE_NEXT, StrParam(i:stNext));
                                    MAX_STATES++;

                                    stSprite = -1;
                                    stFrames = -1;
                                    stTics = -1;
                                    stKeywords = -1;
                                    stFunction = -1;
                                    stParameters = -1;
                                    stNext = 0;

                                    if(f[pStart] == '}')
                                        break;
                                    if(resolved)
                                        continue;
                                }

                                // // Log(a:(f, start, length));

                                // // Log(s:"FLOW CONTROL: IN STATES");
                            }
                            // Log(s:"===== Left state machine for actor ", s:tempActors[currIdx][FIELD_NAME]);
                        }

                        if(checkKey(start, length, FIELD_OBITUARY)) {
                            next();
                            fieldStart = start;
                            fieldEnd = end;
                            tempActors[currIdx][FIELD_OBITUARY] = StrParam(a:(f, fieldStart, fieldEnd-fieldStart+1));

                            if(f[start] == '}')
                                break;
                        }

                        if(checkKey(start, length, FIELD_TRANSLATION)) {
                            next();
                            fieldStart = start;
                            fieldEnd = end;
                            while(next()) {
                                if(f[start] != ',')
                                    break;
                                next();
                                fieldEnd = end;
                            }
                            tempActors[currIdx][FIELD_TRANSLATION] = StrParam(a:(f, fieldStart, fieldEnd-fieldStart+1));

                            if(f[start] == '}')
                                break;
                        }

                        if(checkKey(start, length, FIELD_GAME)) {
                            next();
                            fieldStart = start;
                            fieldEnd = end;
                            tempActors[currIdx][FIELD_GAME] = StrParam(a:(f, fieldStart, fieldEnd-fieldStart+1));

                            if(f[start] == '}')
                                break;
                        }
                    }
                    // Log(s:"Closing actor.");

                    // if(!hasNext()) break;

                    // We're replacing the actor, so just skip all the below garbage.
                    if(currIdx != actorCount)
                        continue;

                    int swapIdx = findTempPivot(currActor, actorCount);
                    for(i = actorCount; i > swapIdx; i--) {
                        actorIdx[i] = actorIdx[i-1];
                    }
                    actorIdx[swapIdx] = currIdx;
                    actorCount++;
                }
            }

            if(fileList[currFile][1] == LUMP_OPEN_FULLPATH)
                break;
        }

        fileList[currFile][0] = 0;
        fileList[currFile][1] = 0;
        currFile++;
    }

    setActorField(-1, DEF_INIT, true);
    setActorField(-1, DEF_COUNT, actorCount);

    for(i = 0; i < actorCount; i++) {
        int o = actorIdx[i];
        int parentIdx = tempActors[o][FIELD_PARENT];

        if(parentIdx != 0) {
            parentIdx = findTempActor(parentIdx, actorCount);
        }

        if(parentIdx <= 0) {
            parentIdx = protoIdx;
        }

        for(j = 0; j < FIELD_MAX; j++) {
            if(tempActors[o][j] == 0) {
                setActorField(i, j, tempActors[parentIdx][j]);
            } else {
                setActorField(i, j, tempActors[o][j]);
            }
        }
    }

    // Needed to split out the "memory clear" method from the double loop above so actors can resolve their heritage cleanly.
    for(i = 0; i < actorCount; i++) {
        for(j = 0; j < FIELD_MAX; j++) {
            tempActors[o][j] = 0;
        }
        actorIdx[i] = 0;
    }
}

script "satanium_dumpactors" (void) NET BUSY
{
    Log(s:"Dumping actors ===================================");
    int count = getActorField(-1, DEF_COUNT);
    for(int i = 0; i < count; i++) {
        str out = "";
        for(int ii = 0; ii < FIELD_MAX; ii++) {
            out = StrParam(s:out, s:getActorField(i, ii), s:", ");
        }
        // Log(s:out);
    }
}

script "satanium_dumpstates" (void) NET BUSY
{
    Log(s:"Dumping states ===================================");
    int count = MAX_STATES;
    for(int i = 0; i < count; i++) {
        str out = StrParam(i:i, s:"[");
        for(int ii = 0; ii < 9; ii++) {
            if(ii+1 == 9) {
                out = StrParam(s:out, s:getStateProp(i, ii), s:"]");
            } else {
                out = StrParam(s:out, s:getStateProp(i, ii), s:", ");
            }
        }
        // Log(s:out);
    }
}

script "satanium_actorinit" (void)
{
    SetResultValue(actors[0] != 0);
}

script "satanium_getactorfield" (int act, int field)
{
    int count = getActorField(-1, DEF_COUNT);
    if(count == 0) {
        // Log(s:"Called too early!");
        SetResultValue("None");
        terminate;
    }

    int id = findActor(act);
    if(id == -1) {
        SetResultValue("None");
        terminate;
    }

    SetResultValue(getActorField(id, field));
}

script "satanium_checkheritage" (int act, int ancestor) { SetResultValue(CheckHeritage(act, ancestor)); }

function int CheckHeritage(str act, str ancestor)
{
    if(StrICmp(act, ancestor) == 0) return true;
    if(StrICmp(act, "Actor") == 0) return false;

    int idx = findActor(act);
    if(idx == -1) return false;
    str parent = getActorField(idx, FIELD_PARENT);

    return CheckHeritage(parent, ancestor);
}

#include "STP_DICT.acs"
script "satanium_resolveState" (int act, int lbl) { SetResultValue(resolveState(act, lbl)); }

function int resolveState(str act, str lbl)
{
    if(StrICmp(act, "Actor") == 0) return false;

    int idx = findActor(act);
    if(idx == -1) return -1;
    str parent = getActorField(idx, FIELD_PARENT);

    int st = getActorField(idx, FIELD_STATES);
    if(st <= 0) return resolveState(parent, lbl);

    int val = getStateProp(st, STATE_ACTOR);
    if(StrICmp(val, act) == 0) {
        while(val == getStateProp(st, STATE_ACTOR)) {
            if(StrICmp(getStateProp(st, STATE_LABEL), lbl) == 0)
                return st;
            st++;
        }
    }

    return resolveState(parent, lbl);
}

int parseVals[10];
function int p_parseInt(str v)
{
    int len = StrLen(v);
    if(len > 10)
        return 0;
    StrCpy(a:parseVals, v);
    int ret = 0;
    for(int i = 0; i < len; i++) {
        if(isWhiteSpace(parseVals[i]))
            continue;
        ret = (ret*10) + parseVals[i]-'0';
    }
    return ret;
}

int params_count = 0;
int params[20];
int params_char[300];

script "satanium_runstate" (int st)
{
    int lbl = getStateProp(st, STATE_LABEL);

    for(; lbl == getStateProp(st, STATE_LABEL); st++)
    {
        int func = getStateProp(st, STATE_FUNCTION);
        if(func <= 0) continue;
        str parm = getStateProp(st, STATE_PARAMETERS);

        CallACS("satanium_runcommand", func, parm);
    }
}

script "satanium_runcommand" (int func, int parm, int client)
{
    breakParameters(parm);
    // // Log(s:func_str[func], s:" ", s:params[0], s:" ", i:params[1]);

    switch(func) {
        case FNC_A_GIVEINVENTORY:
            GiveInventory(params[0], params[1]);
            break;
        case FNC_A_SPAWNITEMEX:
            if(!client) {
                if(checkClassFlag(params[0], "CLIENTSIDEONLY") || checkClassFlag(params[0], "NONETID")) {
                    runAsClient(func, parm);
                    break;
                }
            }

            // // Log(s:func_str[func], s:" ", s:params[0], s:" ", i:params[1], s:" ", i:params[2], s:" ", i:params[3]);
            int u = UniqueTID();
            if(!SpawnForced(params[0], GetActorX(0)+(params[1]<<16), GetActorY(0)+(params[2]<<16), GetActorZ(0)+(params[3]<<16), u, 0))
                terminate;

            int u2 = UniqueTID();
            int a = ActivatorTID();
            Thing_ChangeTID(0, u2);
            SetActivator(u);
            SetPointer(AAPTR_TARGET, u2);
            SetActivator(u2);
            Thing_ChangeTID(0, a);
            Thing_ChangeTID(u, 0);
            break;
        case FNC_ACS_NAMEDEXECUTEWITHRESULT:
            CallACS(params[0], params[1], params[2], params[3], params[4]);
            break;
        case FNC_THRUSTTHINGZ:
            ThrustThingZ(params[0], params[1], params[2], params[3]);
            break;
    }
}

function void breakParameters(str s)
{
    for(int i = 0; i < params_count; i++) {
        params[params_count] = 0;
    }
    params_count = 0;

    if(s <= 0) return;

    StrCpy(a:params_char, s);
    int len = StrLen(s);
    start = 0;
    for(i = 0; i < len; i++)
    {
        if(params_char[i] == ',') {
            parameterize(start, i-1);
            start = i+1;
        }
    }
    parameterize(start, i-1);
}

function void parameterize(int s, int e)
{
    str out;
    if(params_char[s] == '"') {
        out = StrParam(a:(params_char, s+1, e-s-1));
        params[params_count++] = out;
        return;
    }


    out = StrParam(a:(params_char, s, e-s+1));
    params[params_count++] = p_parseInt(out);
}

function void runAsClient(int cmd, str parm)
{
    str packet;
    if(cmd < 10){
        packet = StrParam(s:"00", i:cmd, s:parm);
    } else if(cmd < 100) {
        packet = StrParam(s:"0", i:cmd, s:parm);
    } else {
        packet = StrParam(i:cmd, s:parm);
    }
    NamedSendNetworkString("satanium_runcommand_client", packet);
}

script "satanium_runcommand_client" (int packet) CLIENTSIDE
{
    int cmd = p_parseInt(StrLeft(packet, 3));
    int parm = StrRight(packet, StrLen(packet)-3);
    CallACS("satanium_runcommand", cmd, parm, true);
}


