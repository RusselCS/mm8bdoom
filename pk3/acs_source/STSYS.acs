// COLOR BULLSHIT ====================================================
#include "MEGAPAL.acs"
function bool IsRGB(int x) { return ((x>>0)  & 0x000000FF) == 0; }

#define PAL_INIT 256*3
#define PAL_CYAN PAL_INIT+1
#define PAL_BLUE PAL_INIT+2
#define PAL_BLACK PAL_INIT+3
world int 21: activePalette[];

script "satanium_findPalette" OPEN CLIENTSIDE
{
    if(activePalette[PAL_INIT]) {
        terminate;
    }

    int lastIdx, curIdx;
    curIdx = -1;

    do
    {
        LumpClose(lastIdx);
        lastIdx = curIdx;
        curIdx = LumpOpen("PLAYPAL", curIdx+1);
    }
    until(curIdx == -1);

    LumpReadArray(lastIdx, 0, activePalette, 0);
    LumpClose(lastIdx);

    activePalette[PAL_INIT] = true;
    activePalette[PAL_CYAN] = closestColorFrom8BDM(192);
    activePalette[PAL_BLUE] = closestColorFrom8BDM(198);
    activePalette[PAL_BLACK] = closestColorFrom8BDM(0);
}

function int closestColorFrom8BDM(int idx)
{
    int bestcolor = 0;
    int bestdist = 257*257+257*257+257*257;
    int r = palette_data[idx][0];
    int g = palette_data[idx][1];
    int b = palette_data[idx][2];

    for (int color = 0; color < 256; color++)
    {
        int x = r - activePaletteSlot(color, 0);
        int y = g - activePaletteSlot(color, 1);
        int z = b - activePaletteSlot(color, 2);
        int dist = x*x + y*y + z*z;
        if (dist < bestdist)
        {
            if (dist == 0)
                return color;

            bestdist = dist;
            bestcolor = color;
        }
    }
    return bestcolor;
}

function int activePaletteSlot(int idx, int slot)
{
    return activePalette[(idx*3)+slot];
}

// replacements for the core define script
script "satanium_CreatePlayerTranslation" (int id, int cyan, int blue)
{
    if(IsRGB(cyan) && IsRGB(blue)) {
		CreateTranslation(id,
			activePalette[PAL_CYAN]:activePalette[PAL_CYAN]=[UnpackByte1(cyan), UnpackByte2(cyan), UnpackByte3(cyan)]:[UnpackByte1(cyan), UnpackByte2(cyan), UnpackByte3(cyan)],
			activePalette[PAL_BLUE]:activePalette[PAL_BLUE]=[UnpackByte1(blue), UnpackByte2(blue), UnpackByte3(blue)]:[UnpackByte1(blue), UnpackByte2(blue), UnpackByte3(blue)]
		);
	} else if (IsRGB(cyan)) {
		CreateTranslation(id,
			activePalette[PAL_CYAN]:activePalette[PAL_CYAN]=[UnpackByte1(cyan), UnpackByte2(cyan), UnpackByte3(cyan)]:[UnpackByte1(cyan), UnpackByte2(cyan), UnpackByte3(cyan)],
			activePalette[PAL_BLUE]:activePalette[PAL_BLUE]=[palette_data[blue][0],palette_data[blue][1],palette_data[blue][2]]:[palette_data[blue][0],palette_data[blue][1],palette_data[blue][2]]
		);
	} else if (IsRGB(blue)) {
		CreateTranslation(id,
			activePalette[PAL_CYAN]:activePalette[PAL_CYAN]=[palette_data[cyan][0],palette_data[cyan][1],palette_data[cyan][2]]:[palette_data[cyan][0],palette_data[cyan][1],palette_data[cyan][2]],
			activePalette[PAL_BLUE]:activePalette[PAL_BLUE]=[UnpackByte1(blue), UnpackByte2(blue), UnpackByte3(blue)]:[UnpackByte1(blue), UnpackByte2(blue), UnpackByte3(blue)]
		);
	} else {
		CreateTranslation(id,
			activePalette[PAL_CYAN]:activePalette[PAL_CYAN]=[palette_data[cyan][0],palette_data[cyan][1],palette_data[cyan][2]]:[palette_data[cyan][0],palette_data[cyan][1],palette_data[cyan][2]],
			activePalette[PAL_BLUE]:activePalette[PAL_BLUE]=[palette_data[blue][0],palette_data[blue][1],palette_data[blue][2]]:[palette_data[blue][0],palette_data[blue][1],palette_data[blue][2]]
		);
	}
}

script "satanium_CreatePlayerTranslationGlow" (int id, int cyan, int blue, int black)
{
    int blackThreshold = 27*27 + 27*27 + 27*27;
    int glowStack[256][3];

    for(int i = 0; i < 256; i++) {
        if(i == activePalette[PAL_CYAN]) {
            glowStack[i][0] = IsRGB(cyan) ? UnpackByte1(cyan) : palette_data[cyan][0];
            glowStack[i][1] = IsRGB(cyan) ? UnpackByte2(cyan) : palette_data[cyan][1];
            glowStack[i][2] = IsRGB(cyan) ? UnpackByte3(cyan) : palette_data[cyan][2];
            continue;
        }

        if(i == activePalette[PAL_BLUE]) {
            glowStack[i][0] = IsRGB(blue) ? UnpackByte1(blue) : palette_data[blue][0];
            glowStack[i][1] = IsRGB(blue) ? UnpackByte2(blue) : palette_data[blue][1];
            glowStack[i][2] = IsRGB(blue) ? UnpackByte3(blue) : palette_data[blue][2];
            continue;
        }

        int r = activePaletteSlot(i, 0);
        int g = activePaletteSlot(i, 1);
        int b = activePaletteSlot(i, 2);
        int d = r*r + g*g + b*b;

        if(d <= blackThreshold) {
            glowStack[i][0] = IsRGB(black) ? UnpackByte1(black) : palette_data[black][0];
            glowStack[i][1] = IsRGB(black) ? UnpackByte2(black) : palette_data[black][1];
            glowStack[i][2] = IsRGB(black) ? UnpackByte3(black) : palette_data[black][2];
        } else {
            glowStack[i][0] = r;
            glowStack[i][1] = g;
            glowStack[i][2] = b;
        }
    }

    CreateTranslation(id,
        0:0=[glowstack[0][0],glowstack[0][1],glowstack[0][2]]:[glowstack[0][0],glowstack[0][1],glowstack[0][2]],
        1:1=[glowstack[1][0],glowstack[1][1],glowstack[1][2]]:[glowstack[1][0],glowstack[1][1],glowstack[1][2]],
        2:2=[glowstack[2][0],glowstack[2][1],glowstack[2][2]]:[glowstack[2][0],glowstack[2][1],glowstack[2][2]],
        3:3=[glowstack[3][0],glowstack[3][1],glowstack[3][2]]:[glowstack[3][0],glowstack[3][1],glowstack[3][2]],
        4:4=[glowstack[4][0],glowstack[4][1],glowstack[4][2]]:[glowstack[4][0],glowstack[4][1],glowstack[4][2]],
        5:5=[glowstack[5][0],glowstack[5][1],glowstack[5][2]]:[glowstack[5][0],glowstack[5][1],glowstack[5][2]],
        6:6=[glowstack[6][0],glowstack[6][1],glowstack[6][2]]:[glowstack[6][0],glowstack[6][1],glowstack[6][2]],
        7:7=[glowstack[7][0],glowstack[7][1],glowstack[7][2]]:[glowstack[7][0],glowstack[7][1],glowstack[7][2]],
        8:8=[glowstack[8][0],glowstack[8][1],glowstack[8][2]]:[glowstack[8][0],glowstack[8][1],glowstack[8][2]],
        9:9=[glowstack[9][0],glowstack[9][1],glowstack[9][2]]:[glowstack[9][0],glowstack[9][1],glowstack[9][2]],
