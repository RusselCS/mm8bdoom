#library "STSYS"

#include "zcommon.acs"

#import "8BDT.acs"

script "satanium_aircontrol" OPEN
{
    // Vanilla MM8BDM
    SetAirControl(0.5);

    // Full speed air movement
    // SetAirControl(0.272);

    SetGameplaySetting("sv_nojump", false);
    SetGameplaySetting("sv_allowjump", true);
}

script "satanium_fixbugsig_r" RESPAWN { ACS_NamedExecuteWithResult("satanium_fixbugsig"); }
script "satanium_fixbugsig" ENTER
{
    SetPlayerProperty(0, 0, PROP_FLY);
}

#define replace_max_limit 1000
int replace_max = 13;
str replacePickups[replace_max_limit][2] = {
    {"BackpackReplace", "WTank"},
    {"CellReplace", "WeaponEnergy"},
    {"CellPackReplace", "BigWeaponEnergy"},
    {"ClipReplace", "WeaponEnergy"},
    {"ClipBoxReplace", "BigWeaponEnergy"},
    {"RocketAmmoReplace", "WeaponEnergy"},
    {"RocketBoxReplace", "BigWeaponEnergy"},
    {"ShellReplace", "WeaponEnergy"},
    {"ShellBoxReplace", "BigWeaponEnergy"},
    {"MedikitReplace", "BigHealth"},
    {"MegasphereReplace", "MegaHealth"},
    {"SoulsphereReplace", "MegaHealth"},
    {"StimpackReplace", "SmallHealth"},

    // {"AllmapReplace", ""},
    // {"ArmorBonusReplace", ""},
    // {"BerserkReplace", ""}, technically a weapon
    // {"BlueArmorReplace", ""},
    // {"BlurSphereReplace", ""},
    // {"GreenArmorReplace", ""},
    // {"HealthBonusReplace", ""},
    // {"InfraredReplace", ""},
    // {"InvulnerabilitySphereReplace", ""},
    // {"RadSuitReplace", ""},
};

int showTable = false;

script "satanium_replacepickup" (int mass)
{
    if(timer() < 2) delay(2);

    str replacement = "None";
    int i;
    int findIndex = -1;
    str cls = GetActorClass(0);

    for(i = 0; i < replace_max; i++) {
        if(StrLen(replacePickups[i][0]) == 0)
            break;

        if(StrICmp(cls, replacePickups[i][0]) == 0) {
            replacement = replacePickups[i][1];
            findIndex = i;
            break;
        }
    }

    // Pickup not found, registering.
    if(findIndex == -1) {
        int wepIdx = -1;
        if(mass == 1) {
            wepIdx = randomBusterUpgradeEx(true, -1, -1);
            replacement = getBusterUpgrade(wepIdx);
        } else {
            wepIdx = randomWeaponEx(mass, true, -1, -1);
            replacement = getWeaponActor(wepIdx);
        }

        if(wepIdx != -1) {
            findIndex = replace_max++;
            replacePickups[i][0] = cls;
            replacePickups[i][1] = replacement;
        }
    }

    if(findIndex == -1) {
        Log(s:"Failed to find a replacement for ", s:cls);
        terminate;
    }

    if(StrICmp(replacement, "None") == 0) {
        Log(s:"Failed to find a replacement for ", s:cls);
        terminate;
    }

    int spc = getActorArg(-1);
    int arg0 = getActorArg(0);
    int arg1 = getActorArg(1);
    int arg2 = getActorArg(2);
    int arg3 = getActorArg(3);
    int arg4 = getActorArg(4);

    int dropped = CheckFlag(0, "DROPPED");

    // Log(s:GetActorClass(0), s:" ", s:replacement);

    int u = UniqueTID();
    SpawnSpotForced(replacement, 0, u, GetActorAngle(0) >> 8);
    SetActivator(u);
    Thing_ChangeTID(u, 0);
    Thing_SetSpecial(0, spc, arg0, arg1, arg2);
    if(!dropped)
        GiveInventory("Satanium_Undropped", 1);
}

int ArgWhich = -2;
int ArgResult;
str GetArgItems[6] = { "Satanium_GetActorSpecial", "Satanium_GetActorArg0", "Satanium_GetActorArg1", "Satanium_GetActorArg2", "Satanium_GetActorArg3", "Satanium_GetActorArg4" };
function int getActorArg(int arg)
{
    if(ArgWhich != -2)
        return 0;
    ArgWhich = arg;
    GiveInventory(GetArgItems[arg+1], 1);
    ArgWhich = -2;
    return ArgResult;
}

script "satanium_getactorspecial" (int res)
{
    if(ArgWhich == -2)
        terminate;
    ArgResult = res;
}


































