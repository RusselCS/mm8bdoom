script "satanium_passive_register" OPEN
{
    DefineHookFunction(DTADD_HF_ACTOR_DAMAGED, "satanium_handleshield_damage", 0.0);

    DefineHookFunction(DTADD_HF_ACTOR_DAMAGED, "satanium_handlemonster_damage", 1.0);
    DefineHookFunction(DTADD_HF_ACTOR_DAMAGED, "satanium_handlemonster_explosiondamage", 1.0);
    DefineHookFunction(DTADD_HF_ACTOR_DAMAGED, "satanium_handlemonster_fixonhit", -65536.0);
    DefineHookFunction(DTADD_HF_ACTOR_DAMAGED, "satanium_handlemonster_pain", -65536.0);

    DefineHookFunction(DTADD_HF_PROJ, "satanium_switchhitter", 0.0);
}

// SHIELDING ----------------------------------------------------------------------------------------------------------

#define ST_MAX_ITEMS_GLOBAL_LIMIT MAX_ITEMS_GLOBAL_LIMIT+MAX_BUSTER_LIMIT

#define ST_MAX_PASSIVES 1
str satanium_passiveItems[ST_MAX_PASSIVES] = {
    "Satanium_ExitUnit"
};

script "satanium_passive_enter_r" RESPAWN { ACS_NamedExecuteWithResult("satanium_sys_enter"); }
script "satanium_passive_enter" ENTER
{
    int i, ii, count;
    str item;

    for(ii = 0; ii < ST_MAX_PASSIVES; ii++)
    {
        GiveInventory(satanium_passiveItems[ii], 1);
    }

    delay(3);
    while(MAX_ITEMS_GLOBAL == 0 || MAX_BUSTERUPGRADES == 0) { delay(1); }

    int itemCounts[ST_MAX_ITEMS_GLOBAL_LIMIT];
    while(true) {
        bool selected = false;
        for(i = 0; i < MAX_ITEMS_GLOBAL + MAX_BUSTERUPGRADES; i++) {
            if(i < MAX_ITEMS_GLOBAL) {
                item = getAssistItemActor(i);
            } else {
                item = getBusterUpgrade(i-MAX_ITEMS_GLOBAL);
            }

            count = CheckInventory(item);
            if(itemCounts[i] == count) continue;

            bool skip = !(itemCounts[i] > count);
            itemCounts[i] = count;
            if(!skip) continue;

            // Always update counts, but if counts grow that means you just picked up something.
            if(selected) continue;

            str s = GetSelectedInventory();
            for(ii = 0; ii < ST_MAX_PASSIVES; ii++) {
                if(StrCmp(satanium_passiveItems[ii], s) == 0) {
                    skip = false;
                    break;
                }
            }
            if(skip) continue;

            selected = true;
            SetSelectedInventory(item);
        }
        delay(1);
    }
}

script "satanium_handleshield_damage" (int e, int dmg, int type)
{
    dmg = DamageHook_GetEventResult();
    if(dmg == 0)
        terminate;

    int armor = CheckInventory("SataniumArmor_F");
    if(armor == 0)
        terminate;

    if(armor > 0) {
        int resDmg = dmg - armor;
        TakeInventory("SataniumArmor_F", dmg);
    } else {
        resDmg = dmg;
    }

    if(resDmg <= 0) {
        resDmg = 0;
        DamageHook_SetResultValue(1);
        int hp = getActorProperty(0, AProp_Health);
        int mhp = ACS_NamedExecuteWithResult("core_getmaxhealth");
        updateArmor(CheckInventory("SataniumArmor_F"), hp-resDmg);
        if(hp == mhp) delay(1);
        HealThing(1);
    } else {
        DamageHook_SetResultValue(resDmg);
    }
}

script "satanium_handleshield_pickup_healfirst" (int amt)
{
    int mx = CallACS("core_getmaxhealth");
    int cur = CallACS("core_gethealth");
    int over = cur+amt-mx;
    int res = CallACS("core_healscript", amt);

    if(over > 0)
        res = res || CallACS("satanium_handleshield_pickup", over);
    SetResultValue(res);
}

script "satanium_handleheartpart" (int amt)
{
    int res;
    res = res || CallACS("core_CanGainAmmo", true, 100);
    res = res || CallACS("core_CanGainHealth", 100);
    res = res || CallACS("satanium_handleshield_pickup", 200);
    SetResultValue(res);
}

script "satanium_handleshield_pickup" (int amt)
{
    if(CheckInventory("SataniumArmor_F") < 200) {
        setResultValue(true);
    } else {
        SetResultValue(false);
    }
    GiveInventory("SataniumArmor_F", amt);
    updateArmor(CheckInventory("SataniumArmor_F"), GetActorProperty(0, AProp_Health));
}

function void updateArmor(int newArmor, int hp)
{
    SetInventory("SataniumArmorHealthBar_F", min(newArmor, hp));

    if(newArmor >= 100) {
        SetInventory("SataniumArmorBar1_F", 100);
        SetInventory("SataniumArmorBar2_F", newArmor-100);
    } else {
        SetInventory("SataniumArmorBar1_F", newArmor);
        SetInventory("SataniumArmorBar2_F", 0);
    }
}

// ESCAPE UNIT --------------------------------------------------------------------------------------------------------

script "satanium_checkpoint_script_register" OPEN
{
    DefineHookFunction(DTADD_HF_ACTOR_DAMAGED, "satanium_checkpoint_damage", -1.1);
    DefineReservedTIDRange(TID_CHECKPOINTS, TID_CHECKPOINTS + TID_CHECKPOINT_COUNT-1);
}

script "satanium_checkpoint_script_register_client" OPEN CLIENTSIDE
{
    DefineHookFunction(DTADD_HF_UI_TICK_PLAYER, "satanium_exit_ui", 0.0);
}

bool spawnedFirstCheckpoint = false;
script "satanium_checkpoint_startstrong" ENTER
{
    delay(1);
    if(spawnedFirstCheckpoint) terminate;
    spawnedFirstCheckpoint = true;
    autosave();
    CallACS("satanium_spawncheckpoint");
}

#define BT_ANYMOVEMENT BT_FORWARD | BT_BACK | BT_LEFT | BT_RIGHT | BT_JUMP | BT_MOVEUP | BT_MOVEDOWN | BT_ATTACK | BT_ALTATTACK | BT_RELOAD
script "satanium_checkpoint_checkinput_respawn" RESPAWN { CallACS("satanium_checkpoint_checkinput"); }
script "satanium_checkpoint_checkinput" ENTER
{
    int buttons = GetPlayerInput(PlayerNumber(), INPUT_BUTTONS);
    GiveInventory("Satanium_DelayExit", 1);
    while(true) {
        delay(1);

        if(GetActorProperty(0, AProp_Health) <= 0) terminate;
        if(PlayerNumber() < 0) terminate;

        if(!(buttons & BT_ANYMOVEMENT)) continue;
        GiveInventory("Satanium_DelayExit", 1);
    }
}

script "satanium_checkpoint_damage" (void)
{
    GiveInventory("Satanium_DelayExit", 1);
}

function int newCheckpointTID(void)
{
    for(int i = TID_CHECKPOINTS; i < TID_CHECKPOINTS+TID_CHECKPOINT_COUNT; i++)
    {
        if(ThingCount(T_NONE, i) == 0)
            return i;
    }
    return 0;
}

script "satanium_spawncheckpoint" (int msg)
{
    int tid = newCheckpointTID();
    SpawnForced("Satanium_checkpoint", GetActorX(0), GetActorY(0), GetActorZ(0), tid, 0);
}

script "satanium_teleportto" (int tid) NET
{
    if(CheckInventory("Satanium_ExitDelay") > 0) terminate;
    if(tid == 0) terminate;
    if(ThingCount(T_NONE, tid) == 0) terminate;
    if(tid < TID_CHECKPOINTS || tid > TID_CHECKPOINTS + TID_CHECKPOINT_COUNT)
        if(!CallACS("satanium_isthisaplayer", tid)) terminate;

    int u = UniqueTID();
    if(!SpawnSpotForced("TeleportDest2", tid, u, GetActorAngle(tid) >> 8)) terminate;
    CallACS("core_unsolidplayer",0,USP_TOGGLEON);
    GiveInventory("Satanium_SpawnResolid", 1);
    int res = Teleport(u, 0, false);
    Thing_Remove(u);
    if(!res) terminate;

    TakeInventory("Satanium_ExitUnitToggle", 1);
}

script "satanium_isthisaplayer" (int tid)
{
    SetActivator(tid);
    SetResultValue(PlayerNumber() >= 0);
}

script "satanium_exit_toggle" (void)
{
    LocalAmbientSound("item/exittoggle", 128);

    if(CheckInventory("Satanium_ExitUnitToggle") == 0) {
        GiveInventory("Satanium_ExitUnitToggle", 1);
    } else {
        TakeInventory("Satanium_ExitUnitToggle", 1);
    }
}

int escapeVisOldCameraInit = -1;
int escapeVisOldCamera = 0;
int escapeVisOldCameraX = 0;
int escapeVisOldCameraY = 0;
int escapeVisOldCameraZ = 0;
int escapeVisOldCameraAngle = 0;
int escapeVisOldCameraPitch = 0;

int selectedCheckpoint = 0;
int selectedCheckpointTime = -1;

#define EXIT_SIZE_LIMIT MAX_PLAYERS+TID_CHECKPOINT_COUNT

script "satanium_exit_ui" (int ptid, int pln)
{
    if(
        GetPlayerChasecam(ConsolePlayerNumber()) ||
        CheckAutomap() == AUTOMAP_FULLMAP ||
        CheckActorInventory(ptid, "Satanium_ExitUnitToggle") == 0
    ) {
        selectedCheckpoint = 0;
        terminate;
    }

    int i;

    // Build the list of TIDs to scan under.
    int scanTIDs[EXIT_SIZE_LIMIT];
    int scanIcons[EXIT_SIZE_LIMIT];
    int scanActives[EXIT_SIZE_LIMIT];
    int scanOffsX[EXIT_SIZE_LIMIT];
    int scanOffsY[EXIT_SIZE_LIMIT];
    int scanScale[EXIT_SIZE_LIMIT];
    int scanCount = 0;

    for(i = 0; i < MAX_PLAYERS; i++) {
        if(i == pln) continue;
        if(!PlayerInGame(i)) continue;
        scanTIDs[scanCount] = i+PLN_TID;
        scanIcons[scanCount] = CallACS("core_getmugshot", i+1);
        scanActives[scanCount] = scanIcons[scanCount];
        scanOffsX[scanCount] = -4.0;
        scanOffsY[scanCount] = -8.0;
        scanScale[scanCount] = 1.0;
        scanCount++;
    }

    str sprites[8] = {"SPRBJ0","SPRBI0","SPRBK0","SPRBL0","SPRBN0","SPRBM0","SPRBO0","SPRBP0"};
    for(i = TID_CHECKPOINTS; i < TID_CHECKPOINTS + TID_CHECKPOINT_COUNT; i++) {
        if(ThingCount(T_NONE, i) == 0) break;
        scanTIDs[scanCount] = i;
        scanIcons[scanCount] = "SPRBA0";
        scanActives[scanCount] = sprites[(Timer()/3)%8];
        scanOffsX[scanCount] = 0.0;
        scanOffsY[scanCount] = 0.0;
        scanScale[scanCount] = 1.0;
        scanCount++;
    }

    if(scanCount == 0)
        terminate;

    int px = GetActorX(ptid);
    int py = GetActorY(ptid);
    int pz = GetActorZ(ptid) + GetActorViewHeight(ptid);

    int pyaw = GetActorAngle(ptid);
    int camPitch = GetActorPitch(ptid);
    int ppitch = normalize(camPitch);

    int time = Timer();
    if(escapeVisOldCameraInit < time - 1 || escapeVisOldCamera != ptid) {
        escapeVisOldCameraInit = time;
        escapeVisOldCamera = ptid;
        escapeVisOldCameraX = pX;
        escapeVisOldCameraY = pY;
        escapeVisOldCameraZ = pZ;
        escapeVisOldCameraAngle = pyaw;
        escapeVisOldCameraPitch = camPitch;
    }

    int tid, x, y, z;
    int yaw, xydist, pitch, alpha, icon, scale, active;
    int res;

    int lookRange = 0.01;

    int fov = pln >= 0 ? GetPlayerInfo(pln, PLAYERINFO_FOV) : 90;
    int selected = -1;

    for(i = 0; i < scanCount; i++)
    {
        tid = scanTIDs[i];
        x = GetActorX(tid);
        y = GetActorY(tid);
        z = GetActorZ(tid)+(GetActorProperty(tid,AProp_Health)>>1);

        if(selected == -1)
        {
            yaw = VectorAngle(x-px, y-py);
            xydist = VectorLength(x-px, y-py);
            pitch = normalize(-VectorAngle(xydist, z-pz));

            int ydiff = abs(yaw-pyaw);
            if(ydiff > 0.5) {
                if(yaw < pyaw) yaw+=1.0;
                else pyaw+=1.0;
                ydiff = abs(yaw-pyaw);
            }
            if(ydiff < lookRange && abs(pitch-ppitch) < lookRange) {
                active = true;
                selected = i;
            } else {
                active = false;
            }
        }

        if(selected == i) {
            alpha = 1.0;
            icon = scanActives[i];
            scale = 50 * scanScale[i];
        } else {
            alpha = 0.4;
            icon = scanIcons[i];
            scale = 40 * scanScale[i];
        }

        res = CalculateHudMessageOnPosition(x, y, z,
                px, py, pz, pyaw, camPitch,
                escapeVisOldCameraX, escapeVisOldCameraY, escapeVisOldCameraZ, escapeVisOldCameraAngle, escapeVisOldCameraPitch,
                fov, 1.0,
                80 * 20, 60 * 20,
                scale, scale
            );

        if(res != HDMSGPOS_VALID) continue;

        SetHudSize(
            GetHudMessageOnPositionXSize(),
            GetHudMessageOnPositionYSize(),
            false
        );

        int hx = GetHudMessageOnPositionXPos(HDMSGPOS_ALIGN_LEFT, scanOffsX[i]);
        int hy = GetHudMessageOnPositionYPos(HDMSGPOS_ALIGN_TOP, scanOffsY[i]);

        SetFont(icon);
        HudMessageBold(s:"A"; HUDMSG_ALPHA|HUDMSG_NOWRAP|HUDMSG_LAYER_UNDERHUD|HUDMSG_NOTWITHFULLMAP, 0, CR_UNTRANSLATED, hx, hy, HDMSGPOS_ONE_TIC, alpha);
    }

    if(
        ConsolePlayerNumber() != pln ||
        selected == -1
    ) {
        selectedCheckpoint = 0;
        selectedCheckpointTime = -1;
        terminate;
    }

    if(selectedCheckpoint != scanTIDs[selected]) {
        AmbientSound("menu/itemwheel/select", 64);
        selectedCheckpoint = scanTIDs[selected];
        selectedCheckpointTime = Timer();
        terminate;
    }

    if(Timer()-selectedCheckpointTime > 35) {
        selectedCheckpointTime = Timer();
        SetActivatorToPlayer(pln);
        NamedRequestScriptPuke("satanium_teleportto", selectedCheckpoint);
    }
}

// MONSTER HANDLERS ---------------------------------------------------------------------------------------------------

script "satanium_handlemonster_status" (int e, int a, int b) EVENT
{
    if(e != GAMEEVENT_ACTOR_SPAWNED)
        terminate;
    if(!CheckFlag(0, "ISMONSTER"))
        terminate;

    GiveInventory("MM8BDMPlayer", 1);
    GiveInventory("CanBeGrabBustered", 1);
    GiveInventory("CanBeMegaArmed", 1);

    while(true) {
        if(GetActorZ(0) == GetActorFloorZ(0)) {
            if(!CheckInventory("IsGrounded")) {
                GiveInventory("IsGrounded", 1);
                TakeInventory("IsAirborne", 1);
            }
        } else {
            if(!CheckInventory("IsAirborne")) {
                GiveInventory("IsAirborne", 1);
                TakeInventory("IsGrounded", 1);
            }
        }

        if(GetActorProperty(0, AProp_Health) <= 0) {
            if(!CheckInventory("IsDead")) {
                GiveInventory("IsDead", 1);
            }
        } else {
            if(CheckInventory("IsDead")) {
                TakeInventory("IsDead", 1);
            }
        }
        delay(1);
    }
}

script "satanium_handlemonster_noradiusdmg" (int e, int a, int b) EVENT
{
    if(e != GAMEEVENT_ACTOR_SPAWNED)
        terminate;
    if(!CheckFlag(0, "ISMONSTER"))
        terminate;

    // MM8BDM has a LOT of weapons that ONLY deal explosive damage.
    // Removing that from certain monsters entirely is no fun.
    if(CheckFlag(0, "NORADIUSDMG")) {
        CallACS("core_changeactorflag", "NORADIUSDMG", false);
        GiveInventory("Satanium_NoSelfDmg", 1);
    }
}

#define DMG_THRESHOLD 15
script "satanium_handlemonster_damage" (int e, int dmg, int type)
{
    if(!CheckFlag(0,"ISMONSTER"))
        terminate;

    if(!DamageHook_SetActivator(0, AAPTR_DAMAGE_SOURCE))
        terminate;

    if(!MM8BDMPlayer())
        terminate;

    if(DamageHook_SetActivator(0, AAPTR_DAMAGE_INFLICTOR))
        if(CallACS("satanium_getactorfield", GetActorClass(0), FIELD_GAME) != 0)
            terminate;

    dmg = DamageHook_GetEventResult();

    // int overDmg = dmg / 6;
    // if(overDmg <= 0)
    //     terminate;
    // overDmg = (overDmg * overDmg) / 3;
    // DamageHook_SetResultValue(dmg + random(1, 3) * overDmg);

    // [Russel 11/25/2026 - 9:39 PM] if i think about it more though i guess i need to figure out how to make it so 10 damage is 10 damage but 50 damage is 200 damage and 100 damage is like. 2400 damage. or something? i guess?? BFG Spray reasons / idk
    // int over = (dmg-8)/7;
    // DamageHook_SetResultValue(over*over*over);
    // This wasn't fun. Stil takes like a dozen really low ROF weapons to kill a single revenant. Not worth.

    int dmgMult = GetCvar("sv_satanium_damagemult");
    DamageHook_SetResultValue((dmg * dmgMult) >> 16);
}

script "satanium_handlemonster_pain" (int e, int dmg, int type)
{
    if(!CheckFlag(0,"ISMONSTER"))
        terminate;

    dmg = DamageHook_GetEventResult();
    if(dmg <= 0)
        terminate;

    int st = CallACS("satanium_resolvestate", "ClassBase", StrParam(s:"Pain.", s:type));
    // Log(i:st);
    if(st == -1)
        terminate;

    if(!DamageHook_SetActivator(0, AAPTR_DAMAGE_SOURCE))
        terminate;

    int u = UniqueTID();
    int a = ActivatorTID();
    Thing_ChangeTID(0, u);
    DamageHook_SetActivator(0, AAPTR_DAMAGE_TARGET);
    SetPointer(AAPTR_TARGET, u);
    Thing_ChangeTID(u, a);

    CallACS("satanium_runstate", st);
}

script "satanium_handlemonster_explosiondamage" (int e, int dmg, int type)
{
    if(!CheckInventory("Satanium_NoSelfDmg"))
        terminate;
    if(!DamageHook_IsPointerEqual(AAPTR_DAMAGE_SOURCE, AAPTR_DAMAGE_TARGET, 0, 0))
        terminate;
    SetResultValue(0);
}

// Fixes the "Crash" state weapons not properly proccing on monsters.
script "satanium_handlemonster_fixonhit" (int e, int dmg, int type)
{
    if(!CheckFlag(0,"ISMONSTER")) terminate;
    if(CheckFlag(0,"NOBLOOD")) terminate;
    if(DamageHook_GetEventResult() <= 0) terminate;
    if(!DamageHook_SetActivator(0, AAPTR_DAMAGE_SOURCE)) terminate;
    if(!MM8BDMPlayer()) terminate;
    if(!DamageHook_SetActivator(0, AAPTR_DAMAGE_TARGET)) terminate;

    CallACS("core_changeactorflag", "NOBLOOD", true, 0);
    GiveInventory("Satanium_IsBleeding", 1);
    delay(1);
    CallACS("core_changeactorflag", "NOBLOOD", false, 0);
    TakeInventory("Satanium_IsBleeding", 1);
}

// HITSCAN SWITCH HANDLER ---------------------------------------------------------------------------------------------

script "satanium_switchhitter" (void)
{
    int vx, vy, vz;
    int x, y, z;

    // no reason to assume a monster owns this later, so may as well filter it immediately.
    int owner = CallACS("core_gettarget", 0, 1);
    if(owner < 0) terminate;

    // pre-calculate the hypotenuse of the radius to offset the shot from.
    // needed since all hitboxes in this engine are square. "radius" is actual apothem.
    int radius = FixedMul(GetActorProperty(0, AProp_Radius), 1.4142);
    // int radius = GetActorProperty(0, AProp_Radius);

    int act = GetActorClass(0);

    while(ClassifyActor(0) & ACTOR_MISSILE)
    {
        // Don't need z-axis for this since this functionality is basically ONLY for boom-compat maps.
        // This means there should be no floors or ceilings that need shooting with specifically hitscans.
        // 🐊🤞
        vx = GetActorVelX(0);
        vy = GetActorVelY(0);
        vz = GetActorVelZ(0);
        x = GetActorX(0);
        y = GetActorY(0);
        z = GetActorZ(0);
        delay(1);
    }
    int dist = VectorLength(vx, vy);
    if(dist < 1.0) terminate;

    if(!SetActivatorToPlayer(owner)) terminate;
    str spc = GetActorProperty(0, AProp_Species);

    int u = UniqueTID();
    if(!SpawnForced("SataniumGhostMissile", x, y, z+vz, u, 0)) terminate;

    int yaw = VectorAngle(vx, vy);
    int pitch = VectorAngle(dist, vz);
    int range = VectorLength(dist, vz) + radius;

    int u2 = UniqueTID();
    int o = ActivatorTID();
    Thing_ChangeTID(0, u2);
    SetActivator(u);
    SetPointer(AAPTR_TARGET, u2);
    SetActorProperty(0, AProp_Species, spc);
    Thing_ChangeTID(u2, o);
    LineAttack(u, yaw, -pitch, 0, "SataniumSwitchHitter", "None", dist*2, FHF_NORANDOMPUFFZ|FHF_NOIMPACTDECAL);

    Thing_Remove(u);
}

// USE POINTER --------------------------------------------------------------------------------------------------------

script "satanium_pointer_register" OPEN CLIENTSIDE
{
    DefineHookFunction(DTADD_HF_UI_TICK_PLAYER, "satanium_pointer_run", 0.0);
}

script "satanium_pointer_respawn" RESPAWN { CallACS("satanium_pointer_enter"); }
script "satanium_pointer_enter" ENTER
{
    int buttons = GetPlayerInput(-1, MODINPUT_BUTTONS);
    int oldButtons = GetPlayerInput(-1, MODINPUT_OLDBUTTONS);
    while(true)
    {
        if(PlayerNumber() < 0) terminate;
        if(GetActorProperty(0, AProp_Health) <= 0) terminate;
        if((buttons & BT_USE) && !(oldButtons & BT_USE)) {
            LineAttack(0, GetActorAngle(0), GetActorPitch(0), 0, "SataniumSwitchHitter", "None", 2048.0, FHF_NORANDOMPUFFZ|FHF_NOIMPACTDECAL);
            GiveInventory("Satanium_PointerStart", 1);
        }
        if(!(buttons & BT_USE) && (oldButtons & BT_USE)) {
            TakeInventory("Satanium_PointerStart", 1);
            GiveInventory("Satanium_PointerEnd", 1);
        }
        delay(1);
        oldButtons = buttons;
        buttons = GetPlayerInput(-1, MODINPUT_BUTTONS);
    }
}

#define POWERUP_TIME 0x7FFFFFFD
#define RAISE_TIME 4
#define LOWER_TIME 4
int raiseFrames[RAISE_TIME] = { 'A','B','C','D' };
int lowerFrames[LOWER_TIME] = { 'D','E','F','G' };

script "satanium_pointer_run" (int tid, int pln)
{
    int start = GetActorPowerupTics(tid, "Satanium_PointerStart");
    int end = GetActorPowerupTics(tid, "Satanium_PointerEnd");

    if(GetPlayerChasecam(ConsolePlayerNumber()))
        terminate;

    int frame = 'Z';

    if(end > 0) {
        frame = lowerFrames[LOWER_TIME-(end+2)];
    } else {
        if(start > 0) {
            frame = raiseFrames[min(POWERUP_TIME-(start+2), RAISE_TIME-1)];
        }
    }

    if(frame == 'Z')
        terminate;

    int handx = -2.1;
    int handy = 32.1;

    int c = CheckActorInventory(tid, "SBARCyan");
    int b = CheckActorInventory(tid, "SBARBlue");
    int g = CheckActorInventory(tid, "SBARBlack");

    if(c == 0 && b == 0 && c == 0) {
        c = CheckActorInventory(tid, "SBARMugshotCyan");
        b = CheckActorInventory(tid, "SBARMugshotBlue");
        g = CheckActorInventory(tid, "SBARMugshotBlack");
    }

    int alpha = getActorProperty(tid, AProp_Alpha);
    int br = FixedMul(1.0-FixedDiv(GetActorLightLevel(tid) << 16, 255.0), alpha);
    SetHudSize(320, 200, false);
    SetFont("ST_POINT");

    // Brightness layer (ignores dynamic lights. ho hum.)
    HudMessageBold(c:frame; HUDMSG_COLORSTRING|HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_LAYER_UNDERHUD, 0, "Crayon0", handx, handy, 1873, br);
    HudMessageBold(c:frame+14; HUDMSG_COLORSTRING|HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_LAYER_UNDERHUD, 0, getFontPalette(c-1), handx, handy, 1873, alpha);
    HudMessageBold(c:frame+7; HUDMSG_COLORSTRING|HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_LAYER_UNDERHUD, 0, getFontPalette(b-1), handx, handy, 1873, alpha);
    HudMessageBold(c:frame; HUDMSG_COLORSTRING|HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_LAYER_UNDERHUD, 0, getFontPalette(g-1), handx, handy, 1873, alpha);
}

function str getFontPalette(int idx) {
