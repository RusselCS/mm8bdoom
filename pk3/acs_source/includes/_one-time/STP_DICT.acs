    {13,'t','h','i','n','g','_','s','e','t','g','o','a','l'}, // thing_setgoal
    {16,'t','h','i','n','g','_','s','e','t','s','p','e','c','i','a','l'}, // thing_setspecial
    {20,'t','h','i','n','g','_','s','e','t','t','r','a','n','s','l','a','t','i','o','n'}, // thing_settranslation
    {11,'t','h','i','n','g','_','s','p','a','w','n'}, // thing_spawn
    {17,'t','h','i','n','g','_','s','p','a','w','n','f','a','c','i','n','g'}, // thing_spawnfacing
    {16,'t','h','i','n','g','_','s','p','a','w','n','n','o','f','o','g'}, // thing_spawnnofog
    {10,'t','h','i','n','g','_','s','t','o','p'}, // thing_stop
    {11,'t','h','r','u','s','t','t','h','i','n','g'}, // thrustthing
    {12,'t','h','r','u','s','t','t','h','i','n','g','z'}, // thrustthingz
    {15,'t','r','a','n','s','l','u','c','e','n','t','l','i','n','e'}, // translucentline
    {13,'u','s','e','p','u','z','z','l','e','i','t','e','m'}, // usepuzzleitem

};
function int findFunction(int st, int len)
{
    int low = 0;
    int high = FUNC_MAX;
    int res;

    // StrCmp is str2-str1.

    while(low <= high) {
        int mid = low + (high - low) / 2;

        int tlen = func_dict[mid][0];
        if(tlen < len) tlen = len;
        res = 0;
        for(int i = 0; res == 0 && i < tlen; i++) {
            res = func_dict[mid][i+1]-d_lo(f[st+i]);
        }

        if(res == 0)
            return mid;

        if (res < 0)
            low = mid+1;
        else
            high = mid-1;
    }

    return -1;
}

function int d_lo(int x)
{
    if(x < 'A') return x;
    if(x > 'Z') return x;
    return x + 32;
}

#define KEYWORD_MAX 7
function int findKeyword(int st, int len)
{
    int low = 0;
    int high = KEYWORD_MAX;
    int res;

    int dict[KEYWORD_MAX][10] = {
        {6,'b','r','i','g','h','t'},
        {8,'c','a','n','r','a','i','s','e'},
        {4,'f','a','s','t'},
        {5,'l','i','g','h','t'},
        {7,'n','o','d','e','l','a','y'},
        {6,'o','f','f','s','e','t'},
        {4,'s','l','o','w'},
    };

    while(low <= high) {
        int mid = low + (high - low) / 2;

        int tlen = dict[mid][0];
        if(tlen < len) tlen = len;
        res = 0;
        for(int i = 0; res == 0 && i < tlen; i++) {
            res = dict[mid][i+1]-d_lo(f[st+i]);
        }

        if(res == 0)
            return mid;

        if (res < 0)
            low = mid+1;
        else
            high = mid-1;
    }

    return -1;
}
