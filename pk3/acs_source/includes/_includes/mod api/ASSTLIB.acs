function int GetAssistBarID(void)
{
    return ACS_NamedExecuteWithResult("core_getassistbarid");
}

function void SetAssistBarGraphic(int idx, str graphic)
{
    ACS_NamedExecuteWithResult("core_setassistbargraphic", idx, graphic);
}

function void SetAssistBarGraphicOffset(int idx, int x, int y)
{
    ACS_NamedExecuteWithResult("core_setassistbaroffset", idx, x, y);
}

function void SetAssistBarGraphicScale(int idx, int scale)
{
    ACS_NamedExecuteWithResult("core_setassistbargraphicscale", idx, scale);
}

function void SetAssistBarBarAmount(int idx, int currentAmt, int maxAmt)
{
    ACS_NamedExecuteWithResult("core_setassistbarbaramount", idx, currentAmt, maxAmt);
}

function void SetAssistBarBarNumber(int idx, int number)
{
    ACS_NamedExecuteWithResult("core_setassistbarbarnumber", idx, number);
}

function void SetAssistBarBarColor(int idx, int cyan, int blue)
{
    ACS_NamedExecuteWithResult("core_setassistbarbarcolor", idx, cyan, blue);
}

function void SetAssistBarBarColorGlow(int idx, int cyan, int blue, int black)
{
    ACS_NamedExecuteWithResult("core_setassistbarbarcolor", idx, cyan, blue, black);
}

function void SetAssistBarBarGraphics(int idx, int vertBar, int horiBar)
{
    ACS_NamedExecuteWithResult("core_setassistbarbargraphics", idx, vertBar, horiBar);
}

function void SetAssistBarCallbackScript(int idx, int scriptName)
{
    ACS_NamedExecuteWithResult("core_setassistbarcallbackscript", idx, scriptName);
}

function int ASSTLIB_TicsToSeconds(int tics)
{
    return tics / 35 + (tics % 35 > 0);
}